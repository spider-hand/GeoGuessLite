{
  "name": "client",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:browser": "vitest --config=vitest.browser.config.ts",
    "test:browser:coverage": "vitest --config=vitest.browser.config.ts --run --coverage",
    "generate:api": "openapi-generator generate -i ../server/openapi/openapi.yml -g typescript-fetch -o ./src/services/",
    "build-only": "vite build",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix --cache",
    "format": "prettier --write src/",
    "format:check": "prettier --check src/"
  },
  "dependencies": {
    "@lucide/vue": "^1.17.0",
    "@tanstack/vue-query": "^5.91.2",
    "@vueuse/core": "^14.1.0",
    "emoji-picker-element": "^1.28.0",
    "firebase": "^12.6.0",
    "mapbox-gl": "^3.18.0",
    "mapillary-js": "^4.1.2",
    "pinia": "^3.0.4",
    "vee-validate": "^4.15.1",
    "vue": "^3.5.22",
    "vue-i18n": "^11.4.5",
    "vue-router": "^4.6.3",
    "vuefire": "^3.2.2"
  },
  "devDependencies": {
    "@tsconfig/node22": "^22.0.2",
    "@types/node": "^22.19.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@openapitools/openapi-generator-cli": "^2.34.0",
    "@storybook/addon-a11y": "^10.4.2",
    "@storybook/addon-docs": "^10.4.2",
    "@storybook/addon-vitest": "^10.4.2",
    "@storybook/vue3-vite": "^10.4.2",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/coverage-v8": "4.1.11",
    "@vitest/eslint-plugin": "^1.3.23",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.37.0",
    "eslint-plugin-storybook": "^10.4.2",
    "eslint-plugin-vue": "~10.5.0",
    "jiti": "^2.6.1",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.62.1",
    "prettier": "3.6.2",
    "storybook": "^10.4.2",
    "typescript": "~5.9.0",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.3",
    "vitest": "4.1.11",
    "vitest-browser-vue": "^2.1.0",
    "vue-tsc": "^3.1.1"
  }
}
